{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <main style="max-width:600px;margin:3rem auto;font-family:sans-serif;text-align:center;">
        <h1>🎉 {{ title }}</h1>
        <p>Votre application Symfony est prête.</p>
        <p>Modifiez <code>src/Controller/HomeController.php</code> pour commencer.</p>

        <h2 style="margin-top:2rem;text-align:left;">📋 Tâches</h2>
        {% if tasks is empty %}
            <p style="text-align:left;">Aucune tâche pour le moment.</p>
        {% else %}
            <ul style="list-style:none;padding:0;text-align:left;">
                {% for task in tasks %}
                    <li style="display:flex;align-items:center;gap:0.75rem;padding:0.5rem 0;border-bottom:1px solid #eee;">
                        <span>{{ task.done ? '✅' : '⬜️' }}</span>
                        <span style="flex:1;{{ task.done ? 'text-decoration:line-through;color:#999;' : '' }}">
                            <strong>{{ task.title }}</strong>
                            {% if task.description %}<br><small>{{ task.description }}</small>{% endif %}
                        </span>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

        <p><a href="{{ path('task_index') }}">Gérer toutes les tâches →</a></p>
    </main>
{% endblock %}
